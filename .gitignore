# 宣发工作区：文案、分镜、封面、成片。只在本机，不入库。
/宣发/

# 第三方参考仓库、本地下载的压缩包（不随 demo 分发）
_dl/

# 运行时数据：SQLite、设置里的 API Key / 模之屋 token、
# 记忆向量库、证物、临时文件、SenseVoice / Qwen3-TTS 权重（数 GB）
companion/backend/data/

# 构建时从 node_modules 拷贝的 Silero VAD / ONNX Runtime / AEC3 资源
companion/frontend/public/vad/
companion/frontend/public/aec3/

# Local character turnaround sheets. Reference art, not shipped.
companion/assets/turnaround/

# 用户导入的 3D / 动作 / 音频 / 镜头（第三方版权，体积大，请本地导入）
# 目录本身和说明进仓库，模型/动作文件不进
companion/assets/models/*
!companion/assets/models/.gitkeep
!companion/assets/models/README.txt
companion/assets/motions/*
!companion/assets/motions/.gitkeep
!companion/assets/motions/README.txt

# 本地动作试验（系数预览），不进仓库
companion/motionlab/
companion/assets/audio/*
!companion/assets/audio/.gitkeep
!companion/assets/audio/README.txt
companion/assets/cameras/*
!companion/assets/cameras/.gitkeep
!companion/assets/cameras/README.txt
companion/assets/music/*
!companion/assets/music/.gitkeep
!companion/assets/music/README.txt

companion-3d/public/models/*
!companion-3d/public/models/.gitkeep
!companion-3d/public/models/README.txt
companion-3d/public/motions/*
!companion-3d/public/motions/.gitkeep
!companion-3d/public/motions/README.txt
!companion-3d/public/motions/motions.json

music-api/downloads/*
!music-api/downloads/.gitkeep

# Coin-box compile keys stay on the official build machine.
companion/backend/native/chain.key
companion/backend/native/sealed/
# *.py[cod] above also matches this extension. The server imports this build.
# Private keys are not in the file; they stay in the gitignored .env.
!companion/backend/app/services/coins_box.cp312-win_amd64.pyd

# 桌面打包产物已改到 games 同级的 xiaoke-ai-*，这里只挡仓库内旧路径
companion/CompanionStudio-*/
companion/Xiaoke-*/
companion/xiaoke-ai-*/
companion/xiaoke-ai-A-*/
companion/xiaoke-ai-B*/
companion/xiaoke_ai_*/
companion/build/
companion/dist/

# 塔罗出图运行日志（可能带请求痕迹，不入库）
companion/assets/tarot/_logs/

# 魅影酒馆出图草稿和选图页。正式牌面在 cards/<风格>/*.jpg，左轮用 revolver.png
companion/assets/tavern/*.png
companion/assets/tavern/revolver.jpg
companion/assets/tavern/cards/_pick/

# 空的前端锁文件，不是安装产物
companion/package-lock.json

