# 复制为 .env 后填入。.env 已被 gitignore，不会进 git / 数据库。
# 前端设置里 API Key 留空时，后端自动用这里的配置。

ARK_API_KEY=
# 豆包语音控制台 Key 与方舟 Key 不同时，填写这一项供 ASR / TTS 使用。
# VOLC_SPEECH_API_KEY=
# 没有专用语音 Key 时，识别会用方舟音频理解；可覆盖默认模型。
# VOLC_ASR_MODEL=doubao-seed-2-1-lite-260915
# 小米 Token Plan / API Key，供 MiMo 对话和 TTS 使用。
# XIAOMI_KEY=
# 金币官方编译密钥。只写在打包机的 .env 里，发布包不要带上。
# COIN_BOX_PRIV=
# COIN_BOX_PRIV2=
# COIN_BOX_PEPPER=
# COIN_BOX_PEPPER2=
# COMPANION_LLM_API_KEY=          # 优先于 ARK_API_KEY / OPENAI_API_KEY
# COMPANION_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# COMPANION_LLM_MODEL=doubao-seed-character-260628
# Hugging Face 写权限 token。scripts/upload_hf_pack.py 上传体验包时用，不要提交。
# HF_TOKEN=
